{
  "dev_mode": false,
  "data_dir": "/var/db/skep",
  "socket": {
    "path": "/var/run/skep/agent.sock",
    "group": "skep",
    "allowed_users": ["root", "skep"],
    "request_timeout": "30s",
    "max_connections": 64
  },
  "shutdown_timeout": "10s",
  "log": {
    "level": "info",
    "format": "json"
  },
  "database": {
    "path": "/var/db/skep/agent/agent.db"
  },
  "discovery": {
    "command_timeout": "5s",
    "cache_ttl": "10s"
  },
  "tasks": {
    "workers": 4,
    "queue_size": 64
  },
  "retention": {
    "tasks_days": 90,
    "audit_live_days": 0,
    "audit_archive": true
  },
  "hypervisor": {
    "bhyve": {
      "firmware_dir": "/usr/local/share/edk2-bhyve",
      "host_memory_reserve_bytes": 1073741824,
      "max_vcpus_per_vm": 0,
      "watch_interval": "2s"
    }
  },
  "storage": {
    "pools": [],
    "directories": [],
    "dataset_root": "skep",
    "media_dir": "/var/db/skep/media",
    "max_snapshots_per_resource": 64,
    "capacity_warn_percent": 80,
    "capacity_fail_percent": 90,
    "template_packages": ["FreeBSD-set-minimal"],
    "dist_dir": ""
  },
  "network": {
    "bridges": [],
    "management_interfaces": []
  }
}
