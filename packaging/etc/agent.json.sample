{
  "dev_mode": false,
  "data_dir": "/var/db/skep",
  "socket": {
    "path": "/var/run/skep/agent.sock",
    "group": "skep",
    "allowed_users": ["root", "skep"],
    "request_timeout": "30s",
    "max_connections": 64
  },
  "shutdown_timeout": "10s",
  "log": {
    "level": "info",
    "format": "json"
  },
  "database": {
    "path": "/var/db/skep/agent/agent.db"
  },
  "discovery": {
    "command_timeout": "5s",
    "cache_ttl": "10s"
  },
  "tasks": {
    "workers": 4,
    "queue_size": 64
  }
}
