{
  "dev_mode": false,
  "data_dir": "/var/db/skep",
  "listen_address": "127.0.0.1:8443",
  "agent_socket": "/var/run/skep/agent.sock",
  "read_timeout": "15s",
  "write_timeout": "1m0s",
  "shutdown_timeout": "10s",
  "log": {
    "level": "info",
    "format": "json"
  },
  "database": {
    "path": "/var/db/skep/api/api.db"
  },
  "tls": {
    "cert_file": "",
    "key_file": ""
  },
  "auth": {
    "argon2": {
      "memory_kib": 65536,
      "passes": 3
    },
    "session": {
      "idle_timeout": "30m0s",
      "absolute_timeout": "12h0m0s"
    },
    "login": {
      "per_address_per_minute": 10,
      "failures_before_delay": 5,
      "max_delay": "1m0s",
      "per_username_failures": 50
    },
    "trusted_proxies": []
  },
  "retention": {
    "audit_live_days": 90,
    "audit_archive": true
  }
}
