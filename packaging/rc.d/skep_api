#!/bin/sh
#
# rc.d script for the Skep API server.
#
# PROVIDE: skep_api
# REQUIRE: LOGIN skep_agent
# KEYWORD: shutdown
#
# Add to /etc/rc.conf (or use sysrc) to enable the API server:
#
#   skep_api_enable="YES"
#
# Optional settings and their defaults:
#
#   skep_api_bin="/usr/local/sbin/skep-api"
#       The API server binary.
#   skep_api_runas="skep"
#   skep_api_rungroup="skep"
#       The account and group the API server runs as. Both must exist; this
#       script never creates them. skep-api is the only Skep process that
#       listens on the network. It refuses to run as root and reaches the
#       host only through the agent's socket (ADR 0004).
#   skep_api_data_dir="/var/db/skep"
#       State directory, passed as -data-dir. skep-api keeps its state in
#       the subdirectory "api", which only the service account can open.
#   skep_api_run_dir="/var/run/skep"
#       Holds the pid files, next to the agent socket. Recreated at every
#       start, because /var/run is cleared at boot.
#   skep_api_config=""
#       Configuration file, passed as -config. When empty skep-api reads
#       /usr/local/etc/skep/api.json if that file exists.
#   skep_api_args=""
#       Extra arguments for skep-api, for example "-log-level debug".
#   skep_api_restart_delay="5"
#       Seconds to wait before a crashed API server is started again. "0"
#       turns supervision off.
#   skep_api_syslog_facility="daemon"
#   skep_api_syslog_priority="info"
#   skep_api_syslog_tag="skep-api"
#       skep-api logs JSON lines to stderr; daemon(8) sends them to syslog.
#   skep_api_env=""
#       Environment for skep-api (standard rc.subr variable).
#
# The start order of skep_agent and skep_api does not matter for
# correctness: either may start first or restart alone. Without the agent
# the API answers node requests with 503 agent_unavailable.
#
# skep_api_flags, skep_api_user and skep_api_group are deliberately not
# used: rc.subr would apply them to daemon(8), not to skep-api.

. /etc/rc.subr

name="skep_api"
desc="Skep API server"
rcvar="skep_api_enable"

load_rc_config "${name}"

: "${skep_api_enable:=NO}"
: "${skep_api_bin:=/usr/local/sbin/skep-api}"
: "${skep_api_runas:=skep}"
: "${skep_api_rungroup:=skep}"
: "${skep_api_data_dir:=/var/db/skep}"
: "${skep_api_run_dir:=/var/run/skep}"
: "${skep_api_config:=}"
: "${skep_api_args:=}"
: "${skep_api_restart_delay:=5}"
: "${skep_api_syslog_facility:=daemon}"
: "${skep_api_syslog_priority:=info}"
: "${skep_api_syslog_tag:=skep-api}"

# pidfile is the daemon(8) supervisor, which rc.subr signals and waits for.
# The pid of skep-api itself is in skep_api_child_pidfile.
pidfile="${skep_api_run_dir}/api-supervisor.pid"
skep_api_child_pidfile="${skep_api_run_dir}/api.pid"

command="/usr/sbin/daemon"
procname="daemon"
start_precmd="skep_api_precmd"
start_postcmd="skep_api_poststart"
status_cmd="skep_api_status"

# These would be applied to daemon(8) by rc.subr. See the header.
skep_api_flags=""
unset skep_api_user skep_api_group

skep_api_restart_args=""
case "${skep_api_restart_delay}" in
0)
	;;
*[!0-9]* | "")
	err 1 "skep_api_restart_delay must be a number of seconds"
	;;
*)
	skep_api_restart_args="-R ${skep_api_restart_delay}"
	;;
esac

skep_api_config_args=""
if [ -n "${skep_api_config}" ]; then
	skep_api_config_args="-config ${skep_api_config}"
fi

command_args="-f \
	-S -l ${skep_api_syslog_facility} -s ${skep_api_syslog_priority} -T ${skep_api_syslog_tag} \
	-P ${pidfile} -p ${skep_api_child_pidfile} \
	${skep_api_restart_args} \
	-u ${skep_api_runas} \
	${skep_api_bin} -data-dir ${skep_api_data_dir} ${skep_api_config_args} ${skep_api_args}"

skep_api_precmd()
{
	if [ ! -x "${skep_api_bin}" ]; then
		err 1 "${skep_api_bin} is missing or not executable"
	fi
	if ! /usr/bin/id -u "${skep_api_runas}" >/dev/null 2>&1; then
		err 1 "user ${skep_api_runas} does not exist; create the service account first"
	fi
	if [ "$(/usr/bin/id -u "${skep_api_runas}")" = "0" ]; then
		err 1 "skep_api_runas must not be root: skep-api is the network-facing process"
	fi
	if ! /usr/sbin/pw groupshow "${skep_api_rungroup}" >/dev/null 2>&1; then
		err 1 "group ${skep_api_rungroup} does not exist; create the service account first"
	fi

	# The same layout skep_agent creates; whichever service starts first
	# makes it. The service account can enter the run directory but not
	# write to it: the pid files are written by daemon(8), as root.
	/usr/bin/install -d -o root -g "${skep_api_rungroup}" -m 0750 "${skep_api_run_dir}" ||
		err 1 "cannot create ${skep_api_run_dir}"
	/usr/bin/install -d -o root -g wheel -m 0755 "${skep_api_data_dir}" ||
		err 1 "cannot create ${skep_api_data_dir}"
	/usr/bin/install -d -o "${skep_api_runas}" -g "${skep_api_rungroup}" -m 0700 \
		"${skep_api_data_dir}/api" ||
		err 1 "cannot create ${skep_api_data_dir}/api"
}

# Prints the pid of skep-api itself, or nothing when it is not running.
skep_api_server_pid()
{
	check_pidfile "${skep_api_child_pidfile}" "${skep_api_bin}"
}

# daemon(8) returns as soon as the supervisor exists, even when skep-api
# then fails at once. Wait briefly for it, so that "start" does not report
# success for a service that is only crash-looping.
skep_api_poststart()
{
	_skep_tries=0
	while [ "${_skep_tries}" -lt 50 ]; do
		if [ -n "$(skep_api_server_pid)" ]; then
			return 0
		fi
		sleep 0.2
		_skep_tries=$((_skep_tries + 1))
	done
	warn "skep-api is not running after start; see the ${skep_api_syslog_facility} log, tag ${skep_api_syslog_tag}"
	if [ -n "${skep_api_restart_args}" ]; then
		warn "the supervisor keeps retrying every ${skep_api_restart_delay}s; use 'service ${name} stop' to stop it"
	fi
	return 1
}

# The default status only looks at the supervisor, which stays up while a
# failing skep-api is restarted over and over. Report skep-api itself.
skep_api_status()
{
	if [ -z "${rc_pid}" ]; then
		echo "${name} is not running."
		return 1
	fi
	_skep_api_pid=$(skep_api_server_pid)
	if [ -z "${_skep_api_pid}" ]; then
		echo "${name} is not running: the supervisor (pid ${rc_pid}) is up, but skep-api has exited and is being restarted."
		return 1
	fi
	echo "${name} is running as pid ${_skep_api_pid} (supervisor pid ${rc_pid})."
}

run_rc_command "$1"
