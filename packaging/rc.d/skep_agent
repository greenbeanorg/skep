#!/bin/sh
#
# rc.d script for the Skep host agent.
#
# PROVIDE: skep_agent
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# Add to /etc/rc.conf (or use sysrc) to enable the agent:
#
#   skep_agent_enable="YES"
#
# Optional settings and their defaults:
#
#   skep_agent_bin="/usr/local/sbin/skep-agent"
#       The agent binary.
#   skep_agent_rungroup="skep"
#       The group of the run directory and of the agent socket. Members of
#       this group (the skep-api service account) can reach the socket; the
#       agent additionally checks the peer's UID on every connection. The
#       group must exist; this script never creates it.
#
#       The agent itself runs as root: it has no network listener, and it
#       is the process that will perform privileged host operations
#       (ADR 0004). skep-api, the network-facing process, runs as skep.
#   skep_agent_data_dir="/var/db/skep"
#       State directory, passed to the agent as -data-dir. The agent keeps
#       its database in the subdirectory "agent", which only root can open.
#   skep_agent_run_dir="/var/run/skep"
#       Holds the agent socket and the pid files. Recreated at every
#       start, because /var/run is cleared at boot.
#   skep_agent_config=""
#       Configuration file, passed as -config. When empty the agent reads
#       /usr/local/etc/skep/agent.json if that file exists.
#   skep_agent_args=""
#       Extra arguments for skep-agent, for example "-log-level debug".
#   skep_agent_restart_delay="5"
#       Seconds to wait before a crashed agent is started again. "0" turns
#       supervision off: a crashed agent stays down. A restarted agent
#       never resumes work; it marks unfinished tasks interrupted.
#   skep_agent_syslog_facility="daemon"
#   skep_agent_syslog_priority="info"
#   skep_agent_syslog_tag="skep-agent"
#       The agent logs JSON lines to stderr; daemon(8) sends them to syslog.
#       With the stock syslog.conf, daemon.info goes to /var/log/daemon.log.
#   skep_agent_env=""
#       Environment for the agent (standard rc.subr variable).
#
# skep_agent_flags, skep_agent_user and skep_agent_group are deliberately
# not used: rc.subr would apply them to daemon(8), not to the agent.

. /etc/rc.subr

name="skep_agent"
desc="Skep host agent"
rcvar="skep_agent_enable"

load_rc_config "${name}"

: "${skep_agent_enable:=NO}"
: "${skep_agent_bin:=/usr/local/sbin/skep-agent}"
: "${skep_agent_rungroup:=skep}"
: "${skep_agent_data_dir:=/var/db/skep}"
: "${skep_agent_run_dir:=/var/run/skep}"
: "${skep_agent_config:=}"
: "${skep_agent_args:=}"
: "${skep_agent_restart_delay:=5}"
: "${skep_agent_syslog_facility:=daemon}"
: "${skep_agent_syslog_priority:=info}"
: "${skep_agent_syslog_tag:=skep-agent}"

# pidfile is the daemon(8) supervisor, which rc.subr signals and waits for.
# The agent's own pid is in skep_agent_child_pidfile.
pidfile="${skep_agent_run_dir}/agent-supervisor.pid"
skep_agent_child_pidfile="${skep_agent_run_dir}/agent.pid"

command="/usr/sbin/daemon"
procname="daemon"
start_precmd="skep_agent_precmd"
start_postcmd="skep_agent_poststart"
status_cmd="skep_agent_status"

# These would be applied to daemon(8) by rc.subr. See the header.
skep_agent_flags=""
unset skep_agent_user skep_agent_group

skep_agent_restart_args=""
case "${skep_agent_restart_delay}" in
0)
	;;
*[!0-9]* | "")
	err 1 "skep_agent_restart_delay must be a number of seconds"
	;;
*)
	skep_agent_restart_args="-R ${skep_agent_restart_delay}"
	;;
esac

skep_agent_config_args=""
if [ -n "${skep_agent_config}" ]; then
	skep_agent_config_args="-config ${skep_agent_config}"
fi

command_args="-f \
	-S -l ${skep_agent_syslog_facility} -s ${skep_agent_syslog_priority} -T ${skep_agent_syslog_tag} \
	-P ${pidfile} -p ${skep_agent_child_pidfile} \
	${skep_agent_restart_args} \
	${skep_agent_bin} -data-dir ${skep_agent_data_dir} ${skep_agent_config_args} ${skep_agent_args}"

skep_agent_precmd()
{
	if [ ! -x "${skep_agent_bin}" ]; then
		err 1 "${skep_agent_bin} is missing or not executable"
	fi
	if ! /usr/sbin/pw groupshow "${skep_agent_rungroup}" >/dev/null 2>&1; then
		err 1 "group ${skep_agent_rungroup} does not exist; create the service account first"
	fi

	# /var/run is cleared at boot, so the run directory is made here.
	# root:skep 0750 is the layout ADR 0004 fixes for the agent socket.
	/usr/bin/install -d -o root -g "${skep_agent_rungroup}" -m 0750 "${skep_agent_run_dir}" ||
		err 1 "cannot create ${skep_agent_run_dir}"

	# The data directory is shared with skep-api; each process keeps a
	# private subdirectory that the other cannot open.
	/usr/bin/install -d -o root -g wheel -m 0755 "${skep_agent_data_dir}" ||
		err 1 "cannot create ${skep_agent_data_dir}"

	# One-time migration from Milestone 3, when the agent ran as skep and
	# owned its directory. Everything in it becomes root's, so that the
	# API account can no longer open the agent's database or audit log.
	# -P: symbolic links are changed themselves, never followed.
	_skep_agent_dir="${skep_agent_data_dir}/agent"
	if [ -d "${_skep_agent_dir}" ] && [ ! -L "${_skep_agent_dir}" ] &&
		[ "$(/usr/bin/stat -f %u "${_skep_agent_dir}")" != "0" ]; then
		info "changing the owner of ${_skep_agent_dir} to root: the agent no longer runs as an unprivileged user"
		/usr/sbin/chown -R -P root:wheel "${_skep_agent_dir}" ||
			err 1 "cannot change the owner of ${_skep_agent_dir}"
	fi
	/usr/bin/install -d -o root -g wheel -m 0700 "${_skep_agent_dir}" ||
		err 1 "cannot create ${_skep_agent_dir}"
}

# Prints the pid of the agent itself, or nothing when it is not running.
skep_agent_agent_pid()
{
	check_pidfile "${skep_agent_child_pidfile}" "${skep_agent_bin}"
}

# daemon(8) returns as soon as the supervisor exists, even when the agent
# then fails at once (a bad argument, an unreadable configuration file).
# Wait briefly for the agent, so that "start" does not report success for a
# service that is only crash-looping.
skep_agent_poststart()
{
	_skep_tries=0
	while [ "${_skep_tries}" -lt 50 ]; do
		if [ -n "$(skep_agent_agent_pid)" ]; then
			return 0
		fi
		sleep 0.2
		_skep_tries=$((_skep_tries + 1))
	done
	warn "skep-agent is not running after start; see the ${skep_agent_syslog_facility} log, tag ${skep_agent_syslog_tag}"
	if [ -n "${skep_agent_restart_args}" ]; then
		warn "the supervisor keeps retrying every ${skep_agent_restart_delay}s; use 'service ${name} stop' to stop it"
	fi
	return 1
}

# The default status only looks at the supervisor, which stays up while a
# failing agent is restarted over and over. Report the agent itself.
skep_agent_status()
{
	if [ -z "${rc_pid}" ]; then
		echo "${name} is not running."
		return 1
	fi
	_skep_agent_pid=$(skep_agent_agent_pid)
	if [ -z "${_skep_agent_pid}" ]; then
		echo "${name} is not running: the supervisor (pid ${rc_pid}) is up, but skep-agent has exited and is being restarted."
		return 1
	fi
	echo "${name} is running as pid ${_skep_agent_pid} (supervisor pid ${rc_pid})."
}

run_rc_command "$1"
