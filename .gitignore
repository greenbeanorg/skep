# Build output
/bin/
/dist/
# "go build ./cmd/<name>" without -o writes the binary here
/skep-agent
/skep-api
/skep-cluster
/skepctl
/skep-installer
/skep-setup
/skep-controller

# Local state: databases are never committed
/.skep-dev/
*.db
*.db-shm
*.db-wal
*.sqlite

# Go
*.test
*.out
coverage.*

# Frontend. The built interface is copied to internal/webui/dist for
# embedding (make web-build) and is never committed.
node_modules/
/web/dist/
/internal/webui/dist/
/web/test-results/
/web/playwright-report/

# Secrets and local environment
.env
.env.*
*.pem
*.key

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Python bytecode from test drivers
__pycache__/
*.pyc
